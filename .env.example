# Use the non-root application account from /opt/dockers/mysql/.env.
MYSQL_DATABASE=test_db
MYSQL_USER=test_user
MYSQL_PASSWORD=replace-with-the-existing-MYSQL_PASSWORD

# --- Celery platform (alt_celery3) message middleware ---
CELERY_BROKER_URL=redis://:password@192.168.1.101:16380/6
CELERY_RESULT_BACKEND=redis://:password@192.168.1.101:16380/7
FLOWER_PORT=15567

# --- MySQL web_db (business database that stores generated students) ---
MYSQL_WEB_HOST=192.168.1.101
MYSQL_WEB_PORT=3306
MYSQL_WEB_DATABASE=web_db
MYSQL_WEB_USER=web_user
MYSQL_WEB_PASSWORD=replace-with-the-existing-WEB_DB_PASSWORD

# --- Students API server (poc4-students-api) docs/debug endpoints ---
API_SERVER_DOCS=http://192.168.1.101:8001/docs
API_SERVER_REDOC=http://192.168.1.101:8001/redoc
API_SERVER_JSON=http://192.168.1.101:8001/openapi.json
